# Frontend values are compiled into the public JavaScript bundle; do not place secrets here.
# UAT is served same-origin from the portal, so API base URLs should normally remain empty.
VITE_BASENAME=/home/
VITE_APP_PORT=5005
VITE_AUTH_PROVIDER=oidc
VITE_SFL_IAM_ISSUER=https://identity.uat.example.com/realms/sfl
VITE_SFL_IAM_CLIENT_ID=sfl-operations-ui
VITE_FLEET_API_BASE_URL=
VITE_SAFETY_SECURITY_API_BASE_URL=
VITE_FACILITIES_API_BASE_URL=

# Development-only actor fallback values. Leave blank in UAT; production identity comes from OIDC.
VITE_SFL_USER=
VITE_SFL_DISPLAY_NAME=
VITE_SFL_ROLES=
VITE_SFL_SITES=
VITE_SFL_PROGRAMMES=
VITE_SFL_SYSTEMS=
VITE_FLEET_DEV_FALLBACK=false

# Optional public map-provider key. The UAT build uses OpenStreetMap by default; this is not a secret.
VITE_GOOGLE_MAPS_API_KEY=
