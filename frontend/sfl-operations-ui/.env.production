# Production build. Every service now serves this bundle from /home/ on its own port, so "the same
# origin" is no longer a single answer: the identical bundle runs on 8090, 8091, 8092 and 8093. An
# empty base URL would therefore mean "whichever service happens to be serving me", and the fleet
# screens would call facilities for fleet data the moment you opened them from 8091. Each platform's
# API is named absolutely instead, and CORS on each service allows the other origins.
VITE_BASENAME=/home/
VITE_FLEET_API_BASE_URL=http://localhost:8093

# Behind a gateway that fronts all of them, set these to the path prefixes the gateway routes to and
# they become same-origin again.
VITE_SAFETY_SECURITY_API_BASE_URL=http://localhost:8092

# The build-time actor is gone from production on purpose. It gave an unauthenticated browser the
# roles of a fleet manager, so the dashboard rendered a full console for somebody who had not signed
# in - the services refused the calls, but nothing about the screen said so. Sign-in supplies the
# actor now; `.env` keeps these for the dev server on 5005.
VITE_FLEET_DEV_FALLBACK=false

# Programme and system entitlement are both derived from VITE_SFL_ROLES, which is what IAM will do
# once it is integrated. Neither override is set here on purpose: a build that forced one programme or
# one system would show every user the same slice regardless of who they are.
#   VITE_SFL_PROGRAMMES=FTLMP    # one programme, ignoring the roles
#   VITE_SFL_SYSTEMS=S171        # one system, ignoring the roles

# Place suggestions for origin/destination now run over OpenStreetMap's Nominatim
# (shared/places/openStreetMapPlaces.ts), which needs no key - see that file for the usage-policy
# reasoning. The Google Places key this section used to document is gone along with the code that
# read it; nothing here needs setting for suggestions to work.

# Still `seeded`: the services run with SFL_SECURITY_ENABLED=false and issue no tokens, so the OIDC
# path has nothing to exchange with yet. Flip to `oidc` on the day the identity provider is deployed
# - that is the whole change, because nothing downstream of `provider.ts` knows which one ran.
VITE_AUTH_PROVIDER=seeded
