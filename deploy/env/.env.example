# UAT values are supplied by Infra's secret/config store. Never commit a populated .env file.

# Database credentials (secret). One PostgreSQL database is provisioned per stateful service.
SFL_FACILITIES_POSTGRES_USER=sfl
SFL_FACILITIES_POSTGRES_PASSWORD=change-me
SFL_FACILITIES_POSTGRES_DB=sfl_facilities_service
SFL_SAFETY_SECURITY_POSTGRES_USER=sfl
SFL_SAFETY_SECURITY_POSTGRES_PASSWORD=change-me
SFL_SAFETY_SECURITY_POSTGRES_DB=sfl_safety_security_service
SFL_FLEET_LOGISTICS_POSTGRES_USER=sfl
SFL_FLEET_LOGISTICS_POSTGRES_PASSWORD=change-me
SFL_FLEET_LOGISTICS_POSTGRES_DB=sfl__fleet_vehicle_service

# Optional generic datasource fallbacks; service-specific URLs above take precedence.
SFL_DB_URL=
SFL_DB_USERNAME=
SFL_DB_PASSWORD=
SFL_FACILITIES_DB_URL=jdbc:postgresql://facilities-postgres:5432/sfl_facilities_service
SFL_FACILITIES_DB_USERNAME=sfl
SFL_FACILITIES_DB_PASSWORD=change-me
SFL_SAFETY_SECURITY_DB_URL=jdbc:postgresql://safety-security-postgres:5432/sfl_safety_security_service
SFL_SAFETY_SECURITY_DB_USERNAME=sfl
SFL_SAFETY_SECURITY_DB_PASSWORD=change-me
SFL_FLEET_LOGISTICS_DB_URL=jdbc:postgresql://fleet-vehicle-postgres:5432/sfl__fleet_vehicle_service
SFL_FLEET_LOGISTICS_DB_USERNAME=sfl
SFL_FLEET_LOGISTICS_DB_PASSWORD=change-me

# Primary identity provider: Keycloak. The issuer includes the imported realm path.
SFL_KEYCLOAK_POSTGRES_USER=keycloak
SFL_KEYCLOAK_POSTGRES_PASSWORD=change-me
SFL_KEYCLOAK_POSTGRES_DB=keycloak
SFL_KEYCLOAK_ADMIN=admin
SFL_KEYCLOAK_ADMIN_PASSWORD=change-me
SFL_KEYCLOAK_HOSTNAME=localhost
SFL_IAM_ISSUER=https://identity.uat.example.com/realms/sfl
VITE_SFL_IAM_ISSUER=https://identity.uat.example.com/realms/sfl
VITE_SFL_IAM_CLIENT_ID=sfl-operations-ui

# Secondary/legacy provider retained behind the `zitadel` Compose profile.
SFL_IDP_POSTGRES_USER=zitadel
SFL_IDP_POSTGRES_PASSWORD=change-me
SFL_IDP_POSTGRES_DB=zitadel
SFL_IDP_MASTERKEY=replace-with-a-random-32-character-secret
SFL_IDP_ADMIN=admin
SFL_IDP_ADMIN_PASSWORD=change-me
# Provider-neutral role claim selector. Keycloak is primary; Zitadel can use its map claim when the
# optional profile is selected (the services support both shapes).
SFL_SECURITY_ROLES_CLAIM=realm_access.roles

# Broker connection (credentials are secret; host and port are configuration).
SFL_RABBITMQ_HOST=rabbitmq
SFL_RABBITMQ_PORT=5672
SFL_RABBITMQ_USERNAME=sfl
SFL_RABBITMQ_PASSWORD=change-me
SFL_RABBITMQ_HEALTH_ENABLED=true

# Service ports and security. UAT must keep security enabled.
SFL_PORT=8080
SFL_SECURITY_ENABLED=true
SFL_CORS_ALLOWED_ORIGINS=https://sfl-uat.example.com

# Database pool and web-thread limits.
SFL_DB_POOL_MAX_SIZE=10
SFL_DB_POOL_CONNECTION_TIMEOUT_MS=30000
SFL_WEB_MAX_THREADS=20
SFL_WEB_MIN_SPARE_THREADS=4
SFL_JWKS_CONNECT_TIMEOUT=PT3S
SFL_JWKS_READ_TIMEOUT=PT3S

# Event transports and scheduler switches. Keep each scheduler enabled only in its intended process.
SFL_FACILITIES_EVENT_TRANSPORT=rabbitmq
SFL_FACILITIES_EVENT_EXCHANGE=sfl.events
SFL_FACILITIES_DRAINER_ENABLED=true
SFL_SAFETY_SECURITY_EVENT_TRANSPORT=rabbitmq
SFL_SAFETY_SECURITY_EVENT_EXCHANGE=sfl.events
SFL_SAFETY_SECURITY_OUTBOX_DRAINER=true
SFL_SAFETY_SECURITY_OUTBOX_MAX_ATTEMPTS=10
SFL_EMERGENCY_EVENT_TRANSPORT=rabbitmq
SFL_EMERGENCY_EVENT_EXCHANGE=sfl.events
SFL_EMERGENCY_SCHEDULER=true
SFL_EMERGENCY_SCHEDULER_DELAY=60000
SFL_EMERGENCY_SCHEDULER_INITIAL_DELAY=30000
SFL_EMERGENCY_OUTBOX_MAX_ATTEMPTS=10
SFL_FLEET_EVENT_TRANSPORT=rabbitmq
SFL_FLEET_EVENT_EXCHANGE=sfl.events
SFL_FLEET_OUTBOX_SCHEDULER=true
SFL_FLEET_COMPLIANCE_SCHEDULER=true
SFL_FLEET_COMPLIANCE_CRON=0 5 1 * * *
SFL_FLEET_DASHBOARD_SCHEDULER=true
SFL_FLEET_SLA_SCHEDULER=true
SFL_FLEET_NOTIFICATION_PROVIDER=log
SFL_DISPATCH_SCHEDULER=true
SFL_DISPATCH_SCHEDULER_DELAY=PT5M
SFL_DISPATCH_SCHEDULER_INITIAL_DELAY=PT1M
SFL_FUEL_SCHEDULER=true
SFL_FUEL_SCHEDULER_DELAY=PT5M
SFL_FUEL_SCHEDULER_INITIAL_DELAY=PT1M
SFL_RISK_ASSESSMENT_SCHEDULER=true
SFL_RISK_ASSESSMENT_SCHEDULER_DELAY=PT1H
SFL_RISK_ASSESSMENT_SCHEDULER_INITIAL_DELAY=PT2M

# Dashboard/Swagger auto-open flags. Always false in UAT and deployed environments.
SFL_FACILITIES_OPEN_DASHBOARD=false
SFL_FACILITIES_OPEN_SWAGGER=false
SFL_SAFETY_SECURITY_OPEN_DASHBOARD=false
SFL_SAFETY_SECURITY_OPEN_SWAGGER=false
SFL_FLEET_OPEN_DASHBOARD=false
SFL_FLEET_OPEN_SWAGGER=false

# Public portal address. The portal has no database and serves the compiled dashboard at /home/.
SFL_PORTAL_PORT=8080
SFL_PORTAL_PUBLIC_URL=https://sfl-uat.example.com/home
SFL_PORTAL_OPEN_BROWSER=false

# Integration simulator secrets (secret; use UAT-only values if simulators are enabled).
SFL_VENDOR_SIGNATURE_WINDOW=PT5M
SFL_VENDOR_AMI_SIM_SECRET=replace-me
SFL_VENDOR_BMS_SIM_SECRET=replace-me
SFL_VENDOR_CCP_EVENTS_SIM_SECRET=replace-me

# Feature switches and procurement evidence labels.
SFL_S156_PROCUREMENT_GATE_EVIDENCE=vendor-approval
SFL_S157_PROCUREMENT_GATE_EVIDENCE=vendor-approval

# Optional maintenance and audit tuning.
SFL_AUDIT_VERIFICATION_BATCH_SIZE=500
SFL_AUDIT_VERIFICATION_MAX_BATCHES=10
SFL_BOOKING_ADVISORY_LOCK_TIMEOUT=PT5S
