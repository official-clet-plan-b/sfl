<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>gh.edu.clet.sfl</groupId>
    <artifactId>sfl-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SFL Microservices</name>
    <description>Phase 1 SFL microservices workspace aligned to the updated SRS and workflow plan.</description>
    <modules>
        <module>sfl-service-common</module>
        <module>sfl-facilities-service</module>
        <module>sfl-safety-security-service</module>
        <module>sfl-fleet-logistics-service</module>
        <module>sfl-portal-service</module>
    </modules>
    <properties>
        <java.version>17</java.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v22.14.0</node.version>
        <!--
          Inherited by every module. ${project.basedir} resolves per module, so from services/<module>
          this lands on <repo>/frontend - which is why it is written with two levels up and must not
          be "corrected" to one. The aggregator's own copy, in the ui profile below, needs one level.
        -->
        <sfl.ui.dir>${project.basedir}/../../frontend/sfl-operations-ui</sfl.ui.dir>
        <sfl.ui.dist>${sfl.ui.dir}/dist</sfl.ui.dist>

        <!--
          Centralised here rather than redeclared identically in sfl-facilities-service,
          sfl-fleet-logistics-service and sfl-safety-security-service's own <properties>: three
          copies of the same version were consistent by coincidence, not by anything enforcing it, so
          a routine bump in one module could silently diverge from its siblings. A fourth service
          inherits these for free.
        -->
        <archunit.version>1.3.0</archunit.version>
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              Every module's tests run under the "test" Spring profile, and nothing else does: no
              application-test.yml exists anywhere in the reactor, so this activates no extra config
              by itself. Its purpose is narrower - it is what lets each service's open ("security
              disabled") filter chain be gated with @Profile({"test","local","dev"}) without breaking
              a single one of the dozens of existing tests that already set sfl.security.enabled=false
              deliberately, while a deployment that never sets spring.profiles.active still cannot
              reach that chain merely by a stray SFL_SECURITY_ENABLED=false in its environment.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
              No dependency-convergence or banned-version enforcement existed anywhere in the reactor -
              a future transitive-version conflict, or a coordinate that should never appear, would
              otherwise resolve silently. dependencyConvergence is intentionally not turned on: with
              only 3 non-BOM-managed coordinates (archunit, springdoc-openapi, testcontainers) and every
              Spring dependency inherited version-less from the Boot BOM, there is nothing today for it
              to catch, and it would make every future intentional exclusion an enforcer negotiation
              instead of a POM change. bannedDependencies is the part actually worth having: it fails
              the build the moment log4j or a SNAPSHOT dependency is ever pulled in, rather than relying
              on someone noticing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-no-banned-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!--
                                      Not banning SNAPSHOT dependencies here: every module in this
                                      reactor is itself 0.1.0-SNAPSHOT and depends on its siblings by
                                      that version, so requireReleaseDeps would fail this pre-1.0
                                      reactor's own inter-module dependencies, not catch a real problem.
                                    -->
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-core:(,2.17.1)</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              No static analysis existed anywhere in this reactor - a resource leak, a null
              dereference, or a genuine concurrency bug (inconsistent synchronization, a double-checked
              lock without volatile, a wait/notify outside a synchronized block) could reach main with
              nothing catching it before a human review did. SpotBugs looks for exactly that class of
              defect from bytecode, not style - it does not care about formatting, only correctness.
              Bound to `verify` and failing the build: a repository with a genuinely broken load-bearing
              pattern (this session's optimistic-locking and outbox work included) should not merge on
              green CI alone. Effort/threshold are tuned deliberately, not left at defaults - see the
              exclude filter below for why a low-priority-informational finding does not fail the build
              by itself, only Medium confidence and above.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.4.1</version>
                <configuration>
                    <effort>Default</effort>
                    <threshold>Medium</threshold>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          -Pui builds the dashboard once, here, before any module is packaged. It lives on the
          aggregator rather than in a service because every service now copies the same dist into its
          own jar: built in a module, the build would race the copies of the modules ahead of it in
          the reactor and they would silently package a stale bundle.
        -->
        <profile>
            <id>ui</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin.version}</version>
                        <!--
                          Not inherited. A profile's plugins are inherited by every child, and each
                          child would resolve ${project.basedir} to its own directory and go looking
                          for services/<module>/../frontend - which does not exist. The dashboard is
                          built exactly once, here, at the top of the reactor.
                        -->
                        <inherited>false</inherited>
                        <configuration>
                            <workingDirectory>${project.basedir}/../frontend/sfl-operations-ui</workingDirectory>
                            <installDirectory>${project.basedir}/../frontend/sfl-operations-ui</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <goals><goal>install-node-and-npm</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration><nodeVersion>${node.version}</nodeVersion></configuration>
                            </execution>
                            <execution>
                                <id>npm-install</id>
                                <goals><goal>npm</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration><arguments>install --no-audit --no-fund</arguments></configuration>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <goals><goal>npm</goal></goals>
                                <phase>generate-resources</phase>
                                <configuration><arguments>run build</arguments></configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>

